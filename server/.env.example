# Local server config — copy to .env and fill in
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production-svitgo-dev-secret"
PORT=3001
CORS_ORIGIN=http://localhost:5173
# AI assistant (server-side only — never expose this key to the browser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used only by `npm run db:seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
